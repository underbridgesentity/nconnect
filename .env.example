# --- Database (Supabase Postgres, af-south-1; pooler connection string) ---
DATABASE_URL=postgres://user:password@host:6543/postgres

# --- Supabase (infrastructure: Storage + Realtime; server only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only, never exposed
SUPABASE_BUCKET_CATALOGUE=catalogue   # public read
SUPABASE_BUCKET_COMPLIANCE=compliance # private
SUPABASE_BUCKET_DOCUMENTS=documents   # private

# --- Auth ---
AUTH_SECRET=                          # openssl rand -base64 32
APP_URL=https://needdconnect.co.za
ENCRYPTION_KEY=                       # AES-256-GCM key (base64, 32 bytes) for ID numbers

# --- PayFast ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox                  # sandbox | live

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=hello@needdconnect.co.za

# --- WhatsApp (Meta Cloud API; falls back to email while disabled) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- SMS (OTP fallback) ---
SMS_PROVIDER=console                  # console | smsportal | clickatell
SMS_API_KEY=

# --- Inngest (scheduled jobs: nightly billing, outbox drain, abandoned signups) ---
# Both keys come from https://app.inngest.com after creating an app and syncing
# https://www.needdconnect.co.za/api/inngest. In the Production environment:
#   Manage > Event Keys   -> INNGEST_EVENT_KEY   (starts with a random string)
#   Manage > Signing Key  -> INNGEST_SIGNING_KEY (starts with signkey-prod-)
# Without the signing key the SDK refuses every request to /api/inngest and no
# job ever runs. Without the event key inngest.send() throws, so the outbox
# never drains. Both are required in production; check the Integrations tab in
# /admin/reports, which says plainly which one is missing.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development only: set to 1 and run `npx inngest-cli@latest dev` to work
# against the local dev server with no keys. Leave unset in production.
INNGEST_DEV=

# --- Vercel Cron (backstop for the nightly billing run) ---
# Any long random string, e.g. `openssl rand -hex 32`. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` to /api/cron/billing at 00:40 UTC
# (02:40 SAST), 40 minutes after the Inngest run. If Inngest already billed
# that date the route stands down; if it did not, this issues the invoices
# anyway. Unset means the route refuses to run rather than running open.
CRON_SECRET=

# --- Optional ---
GOOGLE_MAPS_API_KEY=                  # address autocomplete degrades to manual fields
