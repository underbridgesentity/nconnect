# --- Database (Supabase Postgres, af-south-1; pooler connection string) ---
DATABASE_URL=postgres://user:password@host:6543/postgres

# --- Supabase (infrastructure: Storage + Realtime; server only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only, never exposed
SUPABASE_BUCKET_CATALOGUE=catalogue   # public read
SUPABASE_BUCKET_COMPLIANCE=compliance # private
SUPABASE_BUCKET_DOCUMENTS=documents   # private

# --- Auth ---
AUTH_SECRET=                          # openssl rand -base64 32
APP_URL=https://needdconnect.co.za
ENCRYPTION_KEY=                       # AES-256-GCM key (base64, 32 bytes) for ID numbers

# --- PayFast ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox                  # sandbox | live

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=hello@needdconnect.co.za

# --- WhatsApp (Meta Cloud API; falls back to email while disabled) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- SMS (OTP fallback) ---
SMS_PROVIDER=console                  # console | smsportal | clickatell
SMS_API_KEY=

# --- Vercel Cron (the scheduler for every recurring job) ---
# Any long random string, e.g. `openssl rand -hex 32`. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` to each route in vercel.json:
#   /api/cron/billing            0 0 * * *   nightly billing (02:00 SAST)
#   /api/cron/abandoned-signups  0 * * * *   hourly lead capture
# This one variable is the whole configuration: there is no account to link and
# no keys to sync. Unset means every cron route refuses to run rather than
# running open, so nothing is scheduled at all. The Integrations tab in
# /admin/reports says so plainly, with the last completion of each job.
CRON_SECRET=

# --- Optional ---
GOOGLE_MAPS_API_KEY=                  # address autocomplete degrades to manual fields
